APP_NAME="MSCrossWords"
# URL pública (usada nos links dos e-mails). Na Vercel é detectada sozinha.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database (Neon / Postgres) — https://console.neon.tech
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# SMTP (recuperação de senha e aviso de aprovação) — opcional
# Gmail: use uma "Senha de app" — https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ---------------------------------------------------------------------------
# OpenRouter (dicas em inglês, escritas e conferidas por IA) — https://openrouter.ai/keys
# Sem a chave o app funciona, mas as dicas ficam na tradução em português.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# ---------------------------------------------------------------------------
# Ajuste fino da geração de crosswords (opcional)
# ---------------------------------------------------------------------------
CROSSWORD_TARGET_WORDS="12"
CROSSWORD_CANDIDATE_POOL="40"
